#!/bin/bash
#
# Ülesanne 2: kasutajad failist (iga rida = kasutajanimi)
if [ $# -ne 1 ]; then
    echo "Kasutusjuhend: $0 failinimi"
    exit 1
fi

failinimi=$1
KAUST="$(cd "$(dirname "$0")" && pwd)"

if [ -f "$failinimi" ] && [ -r "$failinimi" ]; then
    echo "fail on korras"
    # '|| [ -n ... ]' käsitleb ka viimast rida, mille lõpus pole reavahetust
    while read -r nimi || [ -n "$nimi" ]; do
        [ -z "$nimi" ] && continue
        bash "$KAUST/lisa_kasutaja" "$nimi"
    done < "$failinimi"
else
    echo "probleem failiga $failinimi"
    exit 1
fi
