#!/bin/bash
#
# Ülesanne 4: kasutajad ja paroolid on eraldi failides
# Kõik vajalik on selle skripti sees, lisaskripte ei kutsuta.
if [ $# -ne 2 ]; then
    echo "Kasutusjuhend: $0 kasutajate_fail paroolide_fail"
    exit 1
fi

kasutajad=$1
paroolid=$2

if [ -f "$kasutajad" ] && [ -r "$kasutajad" ] && [ -f "$paroolid" ] && [ -r "$paroolid" ]; then
    echo "failid on korras"
    # paste -d: ühendab read kujule kasutaja:parool
    while IFS= read -r rida || [ -n "$rida" ]; do
        kasutajanimi=$(echo "$rida" | cut -f1 -d:)
        [ -z "$kasutajanimi" ] && continue

        useradd "$kasutajanimi" -m -s /bin/bash
        kasu_tulemus=$?
        if [ $kasu_tulemus -eq 0 ]; then
            echo "Kasutaja nimega $kasutajanimi on lisatud süsteemi"
            echo "$rida" | chpasswd
            grep "^$kasutajanimi:" /etc/passwd
            ls -la "/home/$kasutajanimi"
        else
            echo "probleem kasutaja $kasutajanimi lisamisega (kood $kasu_tulemus)"
        fi
    done < <(paste -d: "$kasutajad" "$paroolid"; echo)
else
    echo "probleem failidega $kasutajad / $paroolid"
    exit 1
fi
